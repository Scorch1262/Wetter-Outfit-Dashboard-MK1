#!/bin/sh /etc/rc.common
# procd-Startskript für das Outfit-Dashboard (GL.iNet Slate 7, Brume 2 / OpenWrt)
# Ziel: /etc/init.d/outfit-dashboard

START=95
STOP=10
USE_PROCD=1

# Programm und Nutzerdaten (Unterordner daten/) liegen in diesem Ordner
APP_DIR="/root/Outfit-Dashboard"

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 "$APP_DIR/app.py"
	procd_set_param env OUTFIT_HOME="$APP_DIR/daten"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
