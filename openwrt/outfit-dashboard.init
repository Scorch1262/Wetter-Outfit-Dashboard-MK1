#!/bin/sh /etc/rc.common
# procd-Startskript für Outfit-Dashboard-MK1 (GL.iNet / OpenWrt)
# Ziel: /etc/init.d/outfit-dashboard

START=95
STOP=10
USE_PROCD=1

APP_DIR="/opt/outfit-dashboard"

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 "$APP_DIR/app.py"
	procd_set_param env OUTFIT_CONFIG="$APP_DIR/config.json"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
